{
  "name": "ugauniyal.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio of Utkarsh Gauniyal, built with Next.js and TypeScript.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "serve out",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "serve": "^14.2.7",
    "typescript": "^6.0.3"
  }
}
